{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src/scripts",
    "resolveJsonModule": true
  },
  "include": ["src/scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
